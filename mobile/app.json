{
  "expo": {
    "name": "Jsport",
    "slug": "jsport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jsport.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jsport.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jsport",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jsport uses your location to show sports courts near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of the court.",
          "cameraPermission": "Take a photo of the court."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
